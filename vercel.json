{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "installCommand": "echo skip",
  "buildCommand": "bash scripts/vercel_build.sh",
  "outputDirectory": "dist",
  "regions": ["fra1"],
  "rewrites": [
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "de" }], "destination": "/lp/de" },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "lt" }], "destination": "/lp/lt" },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "hu" }], "destination": "/lp/hu" },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "hr" }], "destination": "/lp/hr" },
    { "source": "/", "has": [{ "type": "query", "key": "lang", "value": "en" }], "destination": "/lp/en" },
    { "source": "/", "has": [{ "type": "query", "key": "m", "value": "lt" }], "destination": "/lp/lt" },
    { "source": "/", "has": [{ "type": "query", "key": "m", "value": "hu" }], "destination": "/lp/hu" },
    { "source": "/", "destination": "/lp/en" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/assets/landing/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/assets/atelier/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800, stale-while-revalidate=86400" }]
    }
  ],
  "functions": {
    "api/admin.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/analyze.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/checkout.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/compose.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/deglare.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/enhance.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/health.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/master_compose.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/master_eye.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/order.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/stripe_webhook.py": {
      "maxDuration": 120,
      "excludeFiles": "{node_modules/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    }
  },
  "crons": [
    {
      "path": "/api/order",
      "schedule": "17 3 * * *"
    }
  ]
}
