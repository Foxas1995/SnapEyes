{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/assets/landing/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/atelier/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "functions": {
    "api/admin.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/analyze.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/checkout.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/compose.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/deglare.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/enhance.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/health.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/master_compose.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/master_eye.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    },
    "api/order.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md}"
    },
    "api/stripe_webhook.py": {
      "maxDuration": 60,
      "excludeFiles": "{node_modules,node_modules/**,**/node_modules/**,**/.bin/**,dist/**,public/**,src/**,assets/**,scripts/**,suites/**,.git/**,*.html,*.json,*.ts,*.md,api/_assets/plates/**,api/_assets/atlas/**}"
    }
  },
  "crons": [
    {
      "path": "/api/order",
      "schedule": "17 3 * * *"
    }
  ],
  "buildCommand": "mkdir -p dist && echo probe > dist/index.html",
  "outputDirectory": "dist"
}
